<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.1" xmlns="https://jakarta.ee/xml/ns/jakartaee">
    <servlet>
        <servlet-name>Mail</servlet-name>
        <servlet-class>gator.mail.MailServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Entry</servlet-name>
        <servlet-class>gator.mail.EntryServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>OAuth</servlet-name>
        <servlet-class>gator.mail.OAuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Mail</servlet-name>
        <url-pattern>/mail</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Entry</servlet-name>
        <url-pattern>/Login2</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>OAuth</servlet-name>
        <url-pattern>/oauth/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>Scanner</servlet-name>
        <servlet-class>gator.mail.MailScannerServlet</servlet-class>
    </servlet>
    <servlet-mapping><servlet-name>Scanner</servlet-name><url-pattern>/api/scanner/*</url-pattern></servlet-mapping>
    <listener><listener-class>gator.lib.web.mobile.GatorScannerSessionListener</listener-class></listener>
    <error-page>
        <error-code>403</error-code>
        <location>/errors/403.jsp</location>
    </error-page>
    <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
    <context-param>
        <param-name>gappConfigFile</param-name>
        <param-value>pg_gatormail_identity</param-value>
    </context-param>
    <context-param>
        <param-name>gappContactsDbFile</param-name>
        <param-value>pg_mail_master</param-value>
    </context-param>
</web-app>
